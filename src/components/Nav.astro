---
const links = [
  { href: "#about", label: "About" },
  { href: "#experience", label: "Experience" },
  { href: "#projects", label: "Projects" },
  { href: "#research", label: "Research" },
  { href: "#teaching", label: "Teaching" },
  { href: "#contact", label: "Contact" },
];
---

<nav class="sticky top-0 z-50 bg-slate-950/90 backdrop-blur border-b border-slate-800">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 flex items-center justify-between h-14">
    <a href="#about" class="font-semibold text-white hover:text-sky-400 transition-colors">
      Clemens Fiedler
    </a>
    <div class="hidden sm:flex items-center gap-6">
      {links.map((link) => (
        <a
          href={link.href}
          class="text-sm text-slate-400 hover:text-sky-400 transition-colors"
        >
          {link.label}
        </a>
      ))}
    </div>
    <!-- Mobile: simple list -->
    <div class="sm:hidden flex items-center gap-4">
      {links.map((link) => (
        <a href={link.href} class="text-xs text-slate-400 hover:text-sky-400 transition-colors">
          {link.label}
        </a>
      ))}
    </div>
  </div>
</nav>
