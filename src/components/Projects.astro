---
const projects = [
  {
    title: "Board Game Tools",
    url: "https://clemensfiedler.github.io/board-game-tools/",
    description:
      "A collection of useful tools to simplify routine tasks when playing board games. Currently allows to randomize the order of players and split them into groups.",
  },
  {
    title: "History Quiz",
    url: "https://clemensfiedler.github.io/history-quiz/",
    description:
      "A quiz that asks you to put historical events into the correct order. Currently, two quizzes are supported: Ancient till Late Medieval Events and Video Games.",
  },
];
---

<section id="projects" class="py-16 px-4 sm:px-6">
  <div class="max-w-5xl mx-auto">
    <h2 class="text-2xl font-bold text-white mb-8">Projects</h2>
    <div class="grid sm:grid-cols-2 gap-6">
      {projects.map((project) => (
        <a
          href={project.url}
          target="_blank"
          rel="noopener noreferrer"
          class="group block bg-slate-800 rounded-lg p-6 border border-slate-700 hover:border-sky-500 transition-colors"
        >
          <div class="flex items-center justify-between mb-2">
            <h3 class="text-base font-semibold text-white group-hover:text-sky-400 transition-colors">
              {project.title}
            </h3>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="w-4 h-4 text-slate-500 group-hover:text-sky-400 transition-colors shrink-0"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </div>
          <p class="text-slate-400 text-sm leading-relaxed">{project.description}</p>
        </a>
      ))}
    </div>
  </div>
</section>
