---
import { publications } from '../data/publications';
---

<section id="research" class="py-16 px-4 sm:px-6 bg-slate-900">
  <div class="max-w-5xl mx-auto">
    <h2 class="text-2xl font-bold text-white mb-8">Research</h2>
    <div class="space-y-6">
      {publications.map((pub) => (
        <div class="bg-slate-800 rounded-lg p-6 border border-slate-700">
          <h3 class="text-lg font-semibold text-white leading-snug">{pub.title}</h3>
          <p class="mt-1 text-sky-400 text-sm">{pub.authors.join(", ")}</p>
          <p class="mt-0.5 text-slate-500 text-xs">{pub.date}</p>
          <details class="mt-3 group">
            <summary class="cursor-pointer text-sm text-slate-400 hover:text-sky-400 transition-colors select-none list-none flex items-center gap-1">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="w-4 h-4 transition-transform group-open:rotate-90"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
              </svg>
              Abstract
            </summary>
            <p class="mt-3 text-slate-300 text-sm leading-relaxed">{pub.abstract}</p>
          </details>
        </div>
      ))}
    </div>
  </div>
</section>
